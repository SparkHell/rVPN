# Run rvpn and open the Web UI to import an rVPN:// link.
# For manual setup, set both the real WSS address and its public prekey bundle.
# server_address = "wss://vpn.example.com/api/v1/ws"
# prekey_bundle = "./prekey-bundle.json"
identity_key_file = "./identity.key"
tls_fingerprint = "Chrome"

[socks5]
listen_address = "127.0.0.1:1080"

[http_proxy]
enabled = true
listen_address = "127.0.0.1:1088"

[tun]
enabled = false
mtu = 1420
# All IPv4 destinations are eligible for split routing. Private LAN addresses always bypass the tunnel.
routes = [ "0.0.0.0/0" ]

[dns_proxy]
takeover_system_dns = false  # Windows, macOS and Linux: use both loopback DNS listeners (administrator/root required)
enabled = true
listen_address = "127.0.0.1:1053"
nameservers = [ "https://223.6.6.6/dns-query", "https://223.5.5.5/dns-query" ]

[split_tunnel]
enabled = true
builtin_bypass_countries = [ "CN" ]
block_ads = true
gfwlist_enabled = true

[network]
dns_cache_enabled = true
ech_mode = "prefer"

[server_identity]
trust_on_first_use = true
strict = true

[logging]
file_enabled = true
level = "info"
max_files = 7
directory = "./logs"

[dashboard]
enabled = true
listen_address = "127.0.0.1:9800"
allow_cidrs = ["127.0.0.0/8", "::1/128"]
